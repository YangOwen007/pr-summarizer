# Optional in demo; required in live mode. Server only, never NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional model override. The app falls back to gpt-4.1-mini if this is empty.
OPENAI_MODEL=gpt-4.1-mini

# Default true. Set false only to enable authenticated live reviews.
USE_DEMO_ANALYSIS=true

# Required in live mode: generate a random token of at least 32 characters.
# Share privately with trusted reviewers. Never commit the real value.
ANALYSIS_ACCESS_TOKEN=
